<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".EditMemoActivity">

    <EditText
        android:id="@+id/editTextMemoContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="Enter memo content..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintBottom_toTopOf="@+id/editTextTags"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:layout_marginBottom="8dp"
           android:autofillHints="text" />

       <EditText
           android:id="@+id/editTextTags"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:hint="Tags (comma-separated)"
           android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/buttonSaveMemo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:autofillHints="text" />

    <Button
        android:id="@+id/buttonSaveMemo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        android:layout_marginEnd="8dp"/>

    <androidx.constraintlayout.widget.Guideline
         android:id="@+id/guideline"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         app:layout_constraintGuide_percent="0.5"/>

    <Button
        android:id="@+id/buttonDeleteMemo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Delete"
        style="?attr/materialButtonOutlinedStyle"
        app:strokeColor="@android:color/holo_red_light"
        android:textColor="@android:color/holo_red_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:visibility="gone"/> <!-- Initially hidden -->

</androidx.constraintlayout.widget.ConstraintLayout>
